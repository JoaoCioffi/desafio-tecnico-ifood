"""Painel ao vivo: host, infraestrutura, hardware e agente.

Separado do run_services porque e apresentacao, nao ETL.

Quatro blocos, do mais estatico ao mais volatil:

    HOST              ficha da maquina — lida uma vez, nao muda
    INFRA             o Postgres: imagem, versao, saude, ETL, tabelas, orcamento
    HERMES            o agente: modelo, LM Studio, MCP, sessao, tokens
    HARDWARE STATS    consumo global em tempo real

Coleta cara roda em thread: `docker inspect` + `docker stats` levam ~1s, os
contadores de GPU do Windows ~2,8s e o state.db do Hermes fica em outro
processo. Se fossem chamados no laco de desenho o painel travaria. Aqui eles
rodam a parte e o desenho le sempre o ultimo valor conhecido — por isso a
tela atualiza a cada 0,4s mesmo com coletores lentos.
"""

from __future__ import annotations

import json
import math
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import threading
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

import psutil
import psycopg
import yaml
from colorama import Fore, Style

D, B, R = Style.DIM, Style.BRIGHT, Style.RESET_ALL
VERDE, VERM, AMAR, AZUL = Fore.GREEN, Fore.RED, Fore.YELLOW, Fore.BLUE

GLIFOS = "▁▃▅▇"
PONTO = f" {D}·{R} "

# Apaga do cursor ate o fim da linha. Sem isso, uma linha curta deixa
# resto da linha longa anterior na tela ("...1 conexao" virando
# "...nexao" atras de um valor curto).
FIM = "\033[K"

# Todo valor comeca na coluna 15, seja qual for o bloco — inclusive as
# medidas, onde a seta e o rotulo juntos ocupam o mesmo espaco do rotulo
# sozinho nos outros. E o que faz os quatro blocos lerem como uma tabela so
# em vez de quatro listas soltas.
SEC = f"  {B}{{}}{R}  {D}{{}}{R}{FIM}"
LIN = f"    {D}{{:<11}}{R}{{}}{FIM}"
ESPEC = f"    {D}{{:<11}}{R}{{:<38}}{D}{{}}{R}{FIM}"
MED = f"    {D}{{}}{R} {D}{{:<9}}{R}{{}}  {{:>18}}"


# --------------------------------------------------------------------------- #
# Formatacao
# --------------------------------------------------------------------------- #
def sinal(pct: float) -> str:
    """Barras de sinal, estilo wifi: 4 niveis de 25%.

    Sempre 4 caracteres visiveis — as apagadas ficam em cinza, entao a
    coluna seguinte nunca desalinha.
    """
    pct = max(0.0, min(100.0, pct or 0.0))
    n = 0 if pct <= 0 else min(4, math.ceil(pct / 25))
    cor = VERDE if n <= 2 else (AMAR if n == 3 else VERM)
    return f"{cor}{GLIFOS[:n]}{R}{D}{GLIFOS[n:]}{R}"


_ULTIMA: dict[str, float] = {}


def tendencia(chave: str, valor: float, limiar: float = 0.8) -> str:
    """Seta comparando com a leitura anterior desta mesma metrica.

    O limiar evita a seta piscar entre 11.0% e 11.2% — variacao menor que
    ele conta como estavel. A cor fica de fora de proposito: a severidade
    ja e das barras, a seta so diz a direcao.
    """
    anterior = _ULTIMA.get(chave)
    _ULTIMA[chave] = valor
    if anterior is None or abs(valor - anterior) < limiar:
        return "→"
    return "↗" if valor > anterior else "↘"


def marca(pct: float, rotulo: str = "overclock") -> str:
    """Etiqueta para leitura acima de 100% — nao e erro, e agregacao.

    O rotulo muda porque a causa muda:

        cpu   `overclock`      soma dos nucleos passando do nominal
        gpu   `multi-engine`   o Windows soma 3D + copy + decode + video,
                               entao 130% e mais de um engine ocupado ao
                               mesmo tempo, nao clock acima do nominal
    """
    return f"  {VERDE}{rotulo}{R}" if pct > 100 else ""


def _mil(n) -> str:
    """29471 -> '29.5k'. Token bruto nao cabe na coluna e nao diz nada."""
    n = int(n or 0)
    if n < 1_000:
        return str(n)
    if n < 1_000_000:
        return f"{n / 1_000:.1f}k"
    return f"{n / 1_000_000:.2f}M"


def _duracao(seg: float | None) -> str:
    if seg is None:
        return "—"
    seg = max(0, int(seg))
    if seg < 60:
        return f"{seg} s"
    if seg < 3600:
        return f"{seg // 60} min"
    return f"{seg // 3600} h {seg % 3600 // 60:02d} min"


def _plural(n: int, singular: str, plural: str) -> str:
    return f"{n} {singular if n == 1 else plural}"


_ANSI = re.compile(r"\033\[[0-9;]*[A-Za-z]")


def _cortar(linha: str, largura: int) -> str:
    """Corta a linha na largura do terminal, sem contar os codigos ANSI.

    Linha que passa da largura EMBRULHA, e o terminal passa a contar duas
    linhas fisicas onde o painel conta uma. O `\033[nA` do redesenho sobe de
    menos, o quadro escorrega uma linha por ciclo e deixa a primeira para
    tras — foi assim que 23 cabecalhos de INFRA se empilharam na tela.
    """
    visiveis, saida, i = 0, [], 0
    while i < len(linha):
        if achou := _ANSI.match(linha, i):
            saida.append(achou.group())
            i = achou.end()
            continue
        if visiveis >= largura:
            return "".join(saida) + R + FIM
        saida.append(linha[i])
        visiveis += 1
        i += 1
    return "".join(saida)


def _mem_curta(txt: str) -> str:
    """'41.23MiB / 63.93GiB' -> '41.2 MiB'."""
    bruto = (txt or "").split("/")[0].strip()
    m = re.match(r"([\d.]+)\s*([KMGT]?i?B)", bruto)
    return f"{float(m.group(1)):.1f} {m.group(2)}" if m else (bruto or "—")


def _idade(iso: str) -> float | None:
    """Segundos desde um timestamp do docker inspect.

    O docker devolve nanossegundos ('...T12:33:10.123456789Z') e o
    fromisoformat aceita no maximo 6 casas — dai o corte.
    """
    if not iso or iso.startswith("0001-"):
        return None
    iso = re.sub(r"\.(\d{6})\d+", r".\1", iso.strip()).replace("Z", "+00:00")
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(iso)).total_seconds()
    except ValueError:
        return None


def _powershell(script: str, timeout: int = 20) -> str:
    r = subprocess.run(
        ["powershell", "-NoProfile", "-NonInteractive", "-Command", script],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=timeout,
    )
    return r.stdout.strip()


def _http_json(url: str, timeout: float = 1.5) -> dict | None:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except Exception:
        return None


# --------------------------------------------------------------------------- #
# Coleta
# --------------------------------------------------------------------------- #
class Coletor(threading.Thread):
    """Roda uma coleta lenta em loop e guarda o ultimo resultado."""

    def __init__(self, alvo, intervalo: float) -> None:
        super().__init__(daemon=True)
        self._alvo, self._intervalo = alvo, intervalo
        self._parar = threading.Event()
        self.valor: dict = {}
        self.erro: str = ""

    def run(self) -> None:
        while not self._parar.is_set():
            try:
                self.valor, self.erro = self._alvo() or {}, ""
            except Exception as e:
                self.valor, self.erro = {}, type(e).__name__
            self._parar.wait(self._intervalo)

    def parar(self) -> None:
        self._parar.set()


def hardware() -> dict:
    """Ficha do host. Lida uma vez — nao muda."""
    ficha = {
        "cpu": "CPU desconhecida",
        "cores": psutil.cpu_count(logical=False) or 0,
        "threads": psutil.cpu_count(logical=True) or 0,
        "ram_gb": psutil.virtual_memory().total / 2**30,
        "gpu": "",
        "vram_gb": 0.0,
    }
    if sys.platform != "win32":
        return ficha

    classe = r"HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}"
    script = (
        r"(Get-ItemProperty 'HKLM:\HARDWARE\DESCRIPTION\System\CentralProcessor\0')"
        ".ProcessorNameString; "
        "(Get-CimInstance Win32_VideoController | Select-Object -First 1).Name; "
        f"(Get-ChildItem '{classe}' | ForEach-Object {{ (Get-ItemProperty $_.PSPath)."
        "'HardwareInformation.qwMemorySize' } | Where-Object { $_ } | "
        "Sort-Object -Descending | Select-Object -First 1)"
    )
    try:
        linhas = _powershell(script).splitlines()
        if len(linhas) > 0 and linhas[0].strip():
            ficha["cpu"] = " ".join(linhas[0].split())
        if len(linhas) > 1 and linhas[1].strip():
            ficha["gpu"] = linhas[1].strip()
        if len(linhas) > 2 and linhas[2].strip().isdigit():
            ficha["vram_gb"] = int(linhas[2].strip()) / 2**30
    except Exception:
        pass
    return ficha


def coletar_gpu() -> dict:
    """Uso e VRAM via contadores de performance do Windows.

    Nao depende de nvidia-smi — funciona em GPU AMD tambem.
    """
    if sys.platform != "win32":
        return {}
    script = (
        r"$u=(Get-Counter '\GPU Engine(*)\Utilization Percentage' -EA SilentlyContinue)"
        ".CounterSamples | Measure-Object CookedValue -Sum; "
        r"$m=(Get-Counter '\GPU Adapter Memory(*)\Dedicated Usage' -EA SilentlyContinue)"
        ".CounterSamples | Measure-Object CookedValue -Sum; "
        '"$($u.Sum)"; "$($m.Sum)"'
    )
    linhas = _powershell(script).replace(",", ".").splitlines()
    try:
        return {"uso": float(linhas[0]), "vram_gb": float(linhas[1]) / 2**30}
    except (IndexError, ValueError):
        return {}


_FORMATO_INSPECT = "{{.State.Health.Status}}\t{{.Config.Image}}\t{{.State.StartedAt}}"


def coletar_container(nome: str) -> dict:
    """Identidade, saude e consumo do container numa unica passada.

    Antes o `docker inspect` rodava no laco de desenho — 2,5 subprocessos por
    segundo so para ler uma palavra. Aqui ele vem junto do `docker stats`, na
    mesma thread, a cada 2s.
    """
    ins = subprocess.run(
        ["docker", "inspect", "--format", _FORMATO_INSPECT, nome],
        capture_output=True,
        text=True,
    )
    if ins.returncode != 0:
        return {"estado": "ausente"}

    partes = (ins.stdout.strip().split("\t") + ["", "", ""])[:3]
    dados = {
        "estado": partes[0].strip() or "sem healthcheck",
        "imagem": partes[1].strip(),
        "idade": _idade(partes[2]),
    }

    st = subprocess.run(
        ["docker", "stats", "--no-stream", "--format", "{{json .}}", nome],
        capture_output=True,
        text=True,
    )
    if st.returncode == 0 and st.stdout.strip():
        try:
            dados["stats"] = json.loads(st.stdout.strip().splitlines()[0])
        except json.JSONDecodeError:
            pass
    return dados


TABELAS = ("ingredientes", "perfil", "pratos", "pratos_ingredientes", "evento")

_SQL_METRICAS = (
    "SELECT "
    + ", ".join(f"(SELECT count(*) FROM {t}) AS {t}" for t in TABELAS)
    + ", (SELECT count(*) FROM pg_stat_activity WHERE datname = current_database()) AS conexoes"
    ", pg_size_pretty(pg_database_size(current_database())) AS tamanho"
    ", split_part(current_setting('server_version'), ' ', 1) AS versao"
    ", (SELECT gasto FROM vw_orcamento) AS gasto"
    ", (SELECT restante FROM vw_orcamento) AS restante"
)


def coletar_banco(dsn: str) -> dict:
    """Estado do banco em uma unica ida.

    Uma query so, com subselects. As tabelas tem dezenas de linhas — o custo
    e desprezivel — mas roda em thread propria a 1,5s porque contagem de linha
    nao muda 2,5x por segundo, e o desenho nao pode esperar o banco.
    """
    with psycopg.connect(dsn, connect_timeout=3) as conn:
        linha = conn.execute(_SQL_METRICAS).fetchone()
    chaves = list(TABELAS) + ["conexoes", "tamanho", "versao", "gasto", "restante"]
    return dict(zip(chaves, linha))


# --------------------------------------------------------------------------- #
# Hermes
# --------------------------------------------------------------------------- #
# O Hermes nao expoe API de status: ele grava tudo num SQLite (`state.db`) e
# le a configuracao de um YAML. Os dois sao publicos e ficam no HERMES_HOME,
# entao da para observar o agente de fora, sem instrumentar o Hermes.
def hermes_home() -> Path:
    """Onde o Hermes guarda config, skills e estado.

    Mesma regra do src/backend/hermes/install.py — repetida aqui porque
    `hermes/` nao e um pacote instalavel, e o painel roda de `.docker/`.
    """
    candidatos = []
    if env := os.environ.get("HERMES_HOME"):
        candidatos.append(Path(env).expanduser())
    if base := os.environ.get("LOCALAPPDATA"):
        candidatos.append(Path(base) / "hermes")
    candidatos.append(Path.home() / ".hermes")
    # O criterio e ter o config.yaml, nao so a pasta: uma pasta vazia sobrando
    # de instalacao antiga venceria o home de verdade.
    return next((c for c in candidatos if (c / "config.yaml").is_file()), candidatos[0])


# Um turno do agente pode virar varias sessoes: a raiz mais uma por subagente
# delegado. Somar so a raiz esconderia o custo da delegacao, entao a arvore
# inteira entra na conta. Recursivo de proposito — hoje max_spawn_depth e 1,
# mas o numero continua certo se um dia deixar de ser.
_SQL_ARVORE = """
WITH RECURSIVE raiz AS (
    SELECT id, model, started_at, ended_at
      FROM sessions
     WHERE parent_session_id IS NULL
     ORDER BY started_at DESC
     LIMIT 1
), arvore AS (
    SELECT id FROM raiz
    UNION ALL
    SELECT s.id FROM sessions s JOIN arvore a ON s.parent_session_id = a.id
), soma AS (
    SELECT coalesce(sum(api_call_count), 0)   AS chamadas,
           coalesce(sum(tool_call_count), 0)  AS tools,
           coalesce(sum(input_tokens), 0)     AS entrada,
           coalesce(sum(output_tokens), 0)    AS saida,
           coalesce(sum(reasoning_tokens), 0) AS raciocinio
      FROM sessions WHERE id IN (SELECT id FROM arvore)
), fim AS (
    SELECT tool_name, timestamp
      FROM messages
     WHERE session_id IN (SELECT id FROM arvore) AND tool_name IS NOT NULL
     ORDER BY timestamp DESC LIMIT 1
)
SELECT r.id, r.model, r.started_at, r.ended_at,
       (SELECT count(*) FROM arvore) - 1 AS filhos,
       (SELECT count(*) FROM sessions s
         WHERE s.parent_session_id = r.id AND s.ended_at IS NULL) AS filhos_vivos,
       soma.chamadas, soma.tools, soma.entrada, soma.saida, soma.raciocinio,
       (SELECT count(*) FROM messages
         WHERE session_id IN (SELECT id FROM arvore))                AS mensagens,
       (SELECT count(*) FROM messages
         WHERE session_id IN (SELECT id FROM arvore)
           AND tool_name IS NOT NULL)                                AS tools_vivas,
       (SELECT tool_name FROM fim) AS ultima_tool,
       (SELECT timestamp FROM fim) AS ultima_em
  FROM raiz r, soma
"""


def _sessao_hermes(home: Path) -> dict:
    """Ultima sessao do agente, somada com os subagentes que ela abriu.

    Leitura somente-leitura de um SQLite que outro processo esta escrevendo.
    O Hermes usa WAL (journal_mode: wal), entao leitor concorrente e seguro —
    mas o arquivo pode nem existir ainda, dai o try em volta de tudo.
    """
    banco = home / "state.db"
    if not banco.is_file():
        return {}
    try:
        con = sqlite3.connect(f"file:{banco.as_posix()}?mode=ro", uri=True, timeout=1.0)
    except sqlite3.Error:
        return {}
    try:
        con.row_factory = sqlite3.Row
        linha = con.execute(_SQL_ARVORE).fetchone()
        return dict(linha) if linha else {}
    except sqlite3.Error:
        return {}
    finally:
        con.close()


def coletar_hermes() -> dict:
    """Modelo configurado, estado do LM Studio, do MCP e da ultima sessao."""
    home = hermes_home()
    alvo = home / "config.yaml"
    try:
        cfg = yaml.safe_load(alvo.read_text(encoding="utf-8")) or {}
    except Exception as e:
        # O interpretador entra na mensagem de proposito: um Python da Microsoft
        # Store enxerga um AppData\Local virtualizado, e o mesmo caminho existe
        # para um processo e nao para o outro. Sem saber QUEM leu, nao da para
        # diagnosticar um "arquivo nao encontrado" em arquivo que existe.
        return {
            "falha": f"{type(e).__name__}: {e}",
            "quem": f"{Path(sys.executable).name}{PONTO}{home}",
        }

    modelo = cfg.get("model") or {}
    alvo = modelo.get("default") or ""
    base = (modelo.get("base_url") or "http://127.0.0.1:1234/v1").rstrip("/")
    dados: dict = {
        "modelo": alvo,
        "provider": modelo.get("provider") or "modelo",
        "endereco": re.sub(r"^https?://|/v1$", "", base),
        "ctx_config": modelo.get("context_length"),
    }

    # A API nativa do LM Studio diz o que a /v1 nao diz: se o modelo esta
    # carregado, com que quantizacao e com que contexto. A /v1 fica de
    # reserva para quando o provider nao for LM Studio.
    raiz = base[: -len("/v1")] if base.endswith("/v1") else base
    catalogo = _http_json(f"{raiz}/api/v0/models")
    if catalogo is None:
        dados["api"] = "ok" if _http_json(f"{base}/models") else "fora do ar"
    else:
        dados["api"] = "ok"
        for m in catalogo.get("data") or []:
            if m.get("id") == alvo:
                dados |= {
                    "estado": m.get("state") or "?",
                    "quant": (m.get("quantization") or "").lower(),
                    "arch": m.get("arch") or "",
                    "tool_use": "tool_use" in (m.get("capabilities") or []),
                    "ctx_max": m.get("max_context_length"),
                    "ctx_uso": m.get("loaded_context_length"),
                }
                break

    nosso = (cfg.get("mcp_servers") or {}).get("sabor-da-maria") or {}
    if url := nosso.get("url"):
        dados["mcp_endereco"] = re.sub(r"^https?://|/mcp$", "", url)
        dados["mcp_tools"] = len(((nosso.get("tools") or {}).get("include")) or [])
        saudavel = _http_json(re.sub(r"/mcp/?$", "/health", url))
        dados["mcp"] = (saudavel or {}).get("status", "fora do ar")

    dados |= _sessao_hermes(home)
    return dados


# --------------------------------------------------------------------------- #
# Desenho
# --------------------------------------------------------------------------- #
def apagar_boot(linhas: int) -> int:
    """Apaga as `linhas` que o boot imprimiu — e so elas. Devolve quantas.

    `cls` limpava a tela inteira e levava junto a linha de comando digitada
    pelo usuario, que e a referencia dele do que esta rodando. Aqui o cursor
    sobe exatamente o que foi impresso, apaga linha por linha e volta.

    So `\033[nA` e `\033[K`: sao os unicos escapes que este terminal
    comprovadamente aplica. O `\033[J` chegou a ficar no codigo e deixou uma
    linha de HARDWARE orfa na tela — sinal de que a camada de traducao do
    Windows o descarta.
    """
    n = min(max(0, linhas), shutil.get_terminal_size((120, 40)).lines - 1)
    if n:
        volta = f"\033[{n - 1}A" if n > 1 else ""
        print(f"\033[{n}A" + "\n".join([FIM] * n) + volta, end="", flush=True)
    return n


def _uso_host() -> dict:
    """CPU e RAM do host. Dict vazio se o psutil falhar."""
    try:
        return {"cpu": psutil.cpu_percent(interval=None), "mem": psutil.virtual_memory()}
    except Exception:
        return {}


def _bloco_host(hw: dict) -> list[str]:
    """Ficha da maquina. Nao muda, mas e redesenhada junto: sao tres strings
    prontas por quadro, e manter TUDO num bloco so e o que permite ancorar o
    desenho no topo da tela."""
    especs = []
    if hw["cpu"] != "CPU desconhecida":
        especs.append(("cpu", hw["cpu"], f"{hw['cores']}C/{hw['threads']}T"))
    if hw["gpu"]:
        especs.append(("gpu", hw["gpu"], f"{hw['vram_gb']:.0f} GB" if hw["vram_gb"] else ""))
    if hw["ram_gb"]:
        especs.append(("ram", "", f"{hw['ram_gb']:.1f} GB"))
    if not especs:
        return []
    return [SEC.format("HOST", "ficha da maquina"),
            *(ESPEC.format(r, n, d) for r, n, d in especs)]


def _bloco_infra(container: str, dk: dict, bd: dict, etl: dict | None) -> list[str]:
    """O Postgres como entidade: quem e, desde quando, o que carregou, o que tem."""
    estado = dk.get("estado", "—")
    cor = VERDE if estado == "healthy" else (AMAR if estado == "starting" else VERM)
    linhas = [SEC.format("INFRA", f"{container}  {cor}{estado}{R}")]

    identidade = [dk["imagem"]] if dk.get("imagem") else []
    if bd.get("versao"):
        identidade.append(f"server {bd['versao']}")
    if dk.get("idade") is not None:
        identidade.append(f"no ar ha {_duracao(dk['idade'])}")
    if identidade:
        linhas.append(LIN.format("imagem", PONTO.join(identidade)))

    if etl:
        taxa = etl["itens"] / etl["segundos"] if etl.get("segundos") else 0
        linhas.append(
            LIN.format(
                "etl",
                PONTO.join(
                    [
                        f"{etl['itens']} itens da planilha",
                        _plural(etl["novos"], "novo", "novos"),
                        f"{VERDE}{etl['segundos']:.2f}s{R} {D}({taxa:.0f} it/s){R}",
                    ]
                ),
            )
        )

    linhas.append(
        LIN.format("acesso", f"localhost:5432{PONTO}{D}admin / admin / sabor_da_maria{R}")
    )

    if bd:
        linhas.append(
            LIN.format(
                "tabelas",
                "   ".join(f"{D}{t}{R} {VERDE if bd[t] else D}{bd[t]}{R}" for t in TABELAS),
            )
        )
        linhas.append(
            LIN.format(
                "orcamento",
                f"{D}gasto{R} R$ {bd['gasto']}   {VERDE}restante R$ {bd['restante']}{R}",
            )
        )
        rodape = [str(bd["tamanho"]), _plural(bd["conexoes"], "conexao", "conexoes")]
    else:
        rodape = [f"{AMAR}banco indisponivel{R}"]
    if stats := dk.get("stats"):
        rodape.append(f"{_mem_curta(stats.get('MemUsage'))} residente")
    linhas.append(LIN.format("banco", PONTO.join(rodape)))
    return linhas


def _bloco_hardware(hw: dict, host: dict, g: dict) -> list[str]:
    medidas: list[str] = []
    if host:
        mem = host["mem"]
        medidas.append(
            MED.format(
                tendencia("cpu", host["cpu"]), "cpu", sinal(host["cpu"]), f"{host['cpu']:.1f} %"
            )
            + marca(host["cpu"])
            + FIM
        )
        medidas.append(
            MED.format(
                tendencia("ram", mem.percent),
                "ram",
                sinal(mem.percent),
                f"{mem.used / 2**30:.1f} / {mem.total / 2**30:.1f} GB",
            )
            + FIM
        )
    if (uso := g.get("uso")) is not None:
        medidas.append(
            MED.format(tendencia("gpu", uso), "gpu", sinal(uso), f"{uso:.1f} %")
            + marca(uso, "multi-engine")
            + FIM
        )
        if (vram := g.get("vram_gb")) is not None and hw["vram_gb"]:
            pct = vram / hw["vram_gb"] * 100
            medidas.append(
                MED.format(
                    tendencia("vram", pct, 0.3),
                    "vram",
                    sinal(pct),
                    f"{vram:.1f} / {hw['vram_gb']:.1f} GB",
                )
                + FIM
            )
    if not medidas:
        return []
    return [SEC.format("HARDWARE STATS", "consumo global"), *medidas]


def _bloco_hermes(hm: dict, erro: str = "") -> list[str]:
    """O agente visto de fora: o que serve o modelo, o que ele chamou, quanto gastou."""
    linhas = [SEC.format("HERMES", "agente")]
    if erro:
        return linhas + [LIN.format("estado", f"{VERM}coletor falhou{R}{PONTO}{erro}")]
    if not hm:
        return linhas + [LIN.format("estado", f"{D}coletando...{R}")]
    if falha := hm.get("falha"):
        linhas.append(LIN.format("estado", f"{VERM}{falha}{R}"))
        if quem := hm.get("quem"):
            linhas.append(LIN.format("", f"{D}{quem}{R}"))
        return linhas

    ficha = [x for x in (hm.get("quant"), hm.get("arch")) if x]
    if hm.get("tool_use"):
        ficha.append(f"{VERDE}tool_use{R}")
    nome = hm["modelo"] or "—"
    linhas.append(
        LIN.format("modelo", f"{nome:<34}{D}{PONTO.join(ficha)}{R}" if ficha else nome)
    )

    api = hm.get("api", "fora do ar")
    estado = hm.get("estado", "")
    rotulo = {"loaded": "carregado", "not-loaded": "nao carregado"}.get(estado, estado or "sem info")
    cor = AMAR
    if api != "ok":
        rotulo, cor = "fora do ar", VERM
    elif estado == "loaded":
        cor = VERDE
    detalhe = [f"{cor}{rotulo}{R}"]
    if api == "ok" and (ctx := (hm.get("ctx_uso") or hm.get("ctx_config"))):
        detalhe.append(f"{_mil(ctx)} de contexto")
    linhas.append(LIN.format(hm["provider"], f"{hm['endereco']:<34}{PONTO.join(detalhe)}"))

    if hm.get("mcp_endereco"):
        mcp = hm.get("mcp", "fora do ar")
        cor = VERDE if mcp == "ok" else (AMAR if mcp == "degradado" else VERM)
        linhas.append(
            LIN.format(
                "mcp",
                f"{hm['mcp_endereco']:<34}{cor}{mcp}{R}"
                f"{PONTO}{_plural(hm.get('mcp_tools') or 0, 'ferramenta', 'ferramentas')}",
            )
        )

    if hm.get("id"):
        viva = hm.get("ended_at") is None
        inicio = hm.get("started_at") or 0
        idade = (time.time() if viva else (hm.get("ended_at") or 0)) - inicio
        tools = max(hm.get("tools") or 0, hm.get("tools_vivas") or 0)
        partes = [
            f"{VERDE if viva else D}{'ativa' if viva else 'encerrada'}{R}",
            _duracao(idade),
            _plural(hm.get("mensagens") or 0, "mensagem", "mensagens"),
            f"{tools} tools",
        ]
        if filhos := (hm.get("filhos") or 0):
            vivos = hm.get("filhos_vivos") or 0
            partes.append(f"{VERDE if vivos else D}{filhos} subagentes{R}")
        linhas.append(LIN.format("sessao", f"{hm['id'][-13:]:<34}{PONTO.join(partes)}"))

        if hm.get("ultima_tool"):
            nome = str(hm["ultima_tool"]).replace("mcp__sabor_da_maria__", "")
            ha = time.time() - (hm.get("ultima_em") or 0)
            linhas.append(LIN.format("ultima", f"{B}{nome}{R}{PONTO}ha {_duracao(ha)}"))

        if hm.get("entrada"):
            uso = PONTO.join(
                [
                    f"{_mil(hm.get('entrada'))} entrada",
                    f"{_mil(hm.get('saida'))} saida",
                    f"{_mil(hm.get('raciocinio'))} raciocinio",
                ]
            )
        else:
            uso = f"{D}contabilizados no fim do turno{R}"
        linhas.append(LIN.format("tokens", uso))
    return linhas


def acompanhar(
    dsn: str, container: str, etl: dict | None = None, linhas_boot: int = 0
) -> None:
    """Segura o terminal com o painel. Sai quando o container cai ou no Ctrl+C.

    O painel e montado bloco a bloco conforme o que a maquina deixa ler: sem
    hardware legivel o HARDWARE STATS some, sem banco o INFRA fica so com o
    cabecalho. O HERMES nunca some — quando nao consegue ler, diz por que.
    """
    hw = hardware()
    apagar_boot(linhas_boot)

    gpu = Coletor(coletar_gpu, 3.0)
    docker = Coletor(lambda: coletar_container(container), 2.0)
    banco = Coletor(lambda: coletar_banco(dsn), 1.5)
    hermes = Coletor(coletar_hermes, 2.0)
    coletores = (gpu, docker, banco, hermes)
    for c in coletores:
        c.start()

    _uso_host()  # descarta a leitura de calibracao do psutil
    anterior = 0

    try:
        while True:
            host, g, dk, bd, hm = (
                _uso_host(),
                gpu.valor,
                docker.valor,
                banco.valor,
                hermes.valor,
            )

            # No primeiro ciclo o coletor do docker ainda nao respondeu: o
            # dict vem vazio e nao significa container morto.
            if dk.get("estado") in ("unhealthy", "ausente"):
                print(f"\n  {VERM}✖ container ficou '{dk['estado']}'{R}")
                return

            painel = [
                "",
                *_bloco_host(hw),
                "",
                *_bloco_infra(container, dk, bd, etl),
                "",
                *_bloco_hermes(hm, hermes.erro),
                "",
                *_bloco_hardware(hw, host, g),
                "",
                f"  {D}Ctrl+C para parar e derrubar o container{R}",
            ]

            # Subir N linhas so acerta se N for EXATAMENTE quantas linhas
            # fisicas o quadro anterior ocupou. Tres coisas garantem isso:
            #
            #   corte na largura   linha que embrulha ocupa duas fisicas e
            #                      conta como uma — foi o que empilhou 23
            #                      cabecalhos de INFRA na tela
            #   corte na altura    quadro maior que a janela rola o terminal
            #                      e desloca tudo que ja foi desenhado
            #   altura constante   quadro que encolhe deixaria a cauda do
            #                      anterior; completar com linhas de \033[K
            #                      apaga a cauda e mantem a conta exata
            colunas, linhas = shutil.get_terminal_size((120, 40))
            painel = painel[: max(4, linhas - 2)]
            painel = [_cortar(l, max(40, colunas - 1)) for l in painel]
            painel += [FIM] * max(0, anterior - len(painel))

            if anterior:
                print(f"\033[{anterior}A", end="")
            print("\n".join(painel), flush=True)
            anterior = len(painel)
            time.sleep(0.4)
    finally:
        for c in coletores:
            c.parar()
