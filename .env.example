# Copie para .env e preencha. O .env NAO vai para o repositorio.
#
# Este arquivo e a unica fonte de configuracao sensivel do projeto. O compose
# o le por dois caminhos, de proposito:
#
#   --env-file ../.env   resolve os ${VAR} do docker-compose.yaml
#   env_file: ../.env    injeta as variaveis dentro do container do Hermes
#
# Toda variavel cujo NOME contenha KEY, TOKEN, SECRET, PASSWORD ou CREDENTIAL
# tem o valor mascarado pelo runner no painel e em qualquer erro impresso.

# --------------------------------------------------------------------------- #
# Postgres
#
# DB_HOST vale para quem acessa a partir do host (voce, um script, um cliente
# de banco). Dentro da rede do compose "localhost" nao resolve o banco, entao
# o servico do Hermes sobrescreve para `postgres` — o nome do servico.
# --------------------------------------------------------------------------- #
DB_USER="admin"
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="postgres"

# --------------------------------------------------------------------------- #
# Modelo
#
# Nome generico do projeto. O compose mapeia para OPENAI_API_KEY ao entregar
# ao container, que e o nome pelo qual o Hermes procura a credencial.
# --------------------------------------------------------------------------- #
LLM_PROVIDER_API_KEY=""

# --------------------------------------------------------------------------- #
# Telegram
#
# TOKEN: @BotFather -> /newbot. Se vazar, /revoke no BotFather rotaciona.
#
# ALLOWED_USERS: seu id NUMERICO, nao o @usuario. Pegue com @userinfobot.
# Separe por virgula para mais de uma pessoa.
#
# Sem a allowlist o bot sobe, conecta e aparece online — mas descarta toda
# mensagem de remetente desconhecido, inclusive a sua. A falha e silenciosa.
# --------------------------------------------------------------------------- #
TELEGRAM_BOT_TOKEN=""
# Um SEGUNDO bot, para o agente que simula o cliente. Tem que ser outro
# token: o Telegram recusa dois gateways fazendo polling do mesmo, e o
# segundo se recusa a subir dizendo qual perfil esta em conflito.
TELEGRAM_BOT_TOKEN_CLIENTE=""
TELEGRAM_ALLOWED_USERS=""

# --------------------------------------------------------------------------- #
# Dashboard web — http://localhost:9119
#
# O Hermes RECUSA subir o painel sem autenticacao. Nao ha opcao de dashboard
# aberto: sem um auth provider registrado ele nem abre a porta, e o navegador
# recebe ERR_CONNECTION_CLOSED.
#
# Estas variaveis ficam aqui, e nao como password_hash no config.yaml, porque
# o config.yaml vai para o repositorio e o .env nao.
#
# SECRET mantem a sessao valida entre reinicios. Gere um proprio com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# --------------------------------------------------------------------------- #
HERMES_DASHBOARD_BASIC_AUTH_USERNAME="admin"
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=""
HERMES_DASHBOARD_BASIC_AUTH_SECRET=""
